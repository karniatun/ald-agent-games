# Copy to .env (chmod 600) and fill in. NEVER commit .env.

# HMAC secret issued by the platform when the agent is registered
# (dashboard -> agent settings -> Rotate Secret; shown exactly once).
# Preflight fails until this matches the platform value.
AGENT_GAMES_HMAC_SECRET=REPLACE_WITH_PLATFORM_SECRET

# Kurier (zkVerify proof submission) mainnet API key — from kurier.xyz.
# Only needed when proof submission for our own proofs is enabled.
KURIER_API_KEY=

# Server bind (behind the HTTPS tunnel / reverse proxy).
HOST=127.0.0.1
PORT=8787

AGENT_NAME=ald-ai-agent

# Persistent state (seen proof set + idempotent responses).
DATA_DIR=./data

# Optional independent on-chain confirmation for Gatekeeper tasks.
# Leave unset/off until the proof_tx lookup method is pinned down
# (see PROTOKOL.md) — "on" without a checker fails closed.
GATEKEEPER_ONCHAIN_CHECK=off
